# Tushare Pro is the only external data provider; configure one token source.
TUSHARE_TOKEN=
TUSHARE_TOKEN_FILE=
TUSHARE_API_URL=https://api.waditu.com/dataapi

# SQLite cache is checked before Tushare Pro. Existing cache data is preserved.
QUANTLAB_DATABASE_PATH=./data/quantlab-hfq-v1.db

# Browser origin allowed by the FastAPI CORS middleware
QUANTLAB_FRONTEND_ORIGIN=http://localhost:5173
