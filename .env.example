# Tushare API Token (Optional, for higher frequency or supplementary data)
TUSHARE_TOKEN=
TUSHARE_TOKEN_FILE=
TUSHARE_API_URL=https://api.waditu.com/dataapi

# Run API in Demo Mode using stubbed data
QUANTLAB_DEMO_MODE=false

# SQLite Database path for caching market data
QUANTLAB_DATABASE_PATH=./data/quantlab-hfq-v1.db

# Demo data uses an isolated versioned cache so generated and live bars never mix
QUANTLAB_DEMO_DATABASE_PATH=./data/quantlab-demo-v2.db
